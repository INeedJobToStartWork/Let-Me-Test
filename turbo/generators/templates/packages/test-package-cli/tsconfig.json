{
	"$schema": "http://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"jsx": "react",
		"outDir": "./dist",
		"types": ["node"],
		"alwaysStrict": true, // TS 7 removed `alwaysStrict: false`, which @ineedj/tsconfig/base.json still sets
		"paths": {
			"@/*": ["./src/*", "./src/*/index.ts", "./src/*.ts"]
		},
		// "paths": {
		// },
		"stripInternal": true,
		// "plugins": [
		// 	{
		// 		"transform": "typia/lib/transform"
		// 	}
		// ],
		"preserveSymlinks": true
		// "strict": true
	},
	"extends": "@ineedj/tsconfig/base.json"
}
